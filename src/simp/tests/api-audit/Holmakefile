HOLHEAP = $(HOLDIR)/bin/hol.state0
INCLUDES = ../../src
EXTRA_CLEANS = selftest.exe

selftest.exe: selftest.uo
	$(HOLMOSMLC) -o $@ $<

# One fresh process per import order, foreign owner kind and owner timing.
# Documentation.sml is compiled against the real signatures, not linked.
.PHONY: check
check: selftest.exe Documentation.uo
	@status=0; \
	for order in simp-first cong-first; do \
	  for kind in attribute exporter; do \
	    for owner in before after; do \
	      echo "api-audit: $$order $$kind $$owner"; \
	      API_AUDIT_SRC=$$(pwd)/../../src API_AUDIT_ORDER=$$order \
	      API_AUDIT_KIND=$$kind API_AUDIT_OWNER=$$owner \
	        ./selftest.exe < /dev/null || status=1; \
	    done; \
	  done; \
	done; exit $$status
