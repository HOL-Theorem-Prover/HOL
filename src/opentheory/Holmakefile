ifdef POLY
CLINE_OPTIONS = --poly_not_hol
endif

ifeq ($(KERNELID),otknl)
EXTRA_CLEANS = otpkgcheck.exe

all: otpkgcheck.exe $(DEFAULT_TARGETS)
.PHONY: all

# a standalone binary: this runs from the directory of whatever package
# description it is checking, so it must not depend on a heap beside it
otpkgcheck.exe: otpkgcheck.sml
	$(POLYC) -o $@ $<
endif
