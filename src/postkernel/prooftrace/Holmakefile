.PHONY: all

HAVE_MLTON = $(if $(NO_MLTON),,$(which mlton))

ifdef POLY
CLINE_OPTIONS = --poly_not_hol
endif

ifneq ($(HAVE_MLTON),)

# keep the all target at "head" of file so it remains the default
# target
ifdef HAVE_WORD64
all: pft-replay-test replay-test
else
all: pft-replay-test
endif

# The sources each .mlb pulls in, asked of mlton itself (about 15ms).
# Without them the executables are rebuilt only when their own two files
# change, so an edit to the kernel they compile leaves a stale binary in
# place and the breakage is invisible: a clean checkout fails at once
# while a warm tree says there is nothing to do.
REPLAY_SRCS = $(shell mlton -stop f replay-test.mlb)
PFT_REPLAY_SRCS = $(shell mlton -stop f pft-replay-test.mlb)

replay-test: replay-test.mlb replay-test.sml $(REPLAY_SRCS)
	mlton -default-type intinf $<

pft-replay-test: pft-replay-test.mlb pft-replay-test.sml $(PFT_REPLAY_SRCS)
	mlton -default-type intinf $<


else

$(info *** Doing nothing when no mlton)
all:
endif

EXTRA_CLEANS = replay-test pft-replay-test
