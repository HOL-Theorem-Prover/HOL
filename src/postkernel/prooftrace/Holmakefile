.PHONY: all

HAVE_MLTON = $(if $(NO_MLTON),,$(which mlton))

ifdef POLY
CLINE_OPTIONS = --poly_not_hol
endif

ifneq ($(HAVE_MLTON),)
# The sources an .mlb pulls in, asked of mlton itself (~15ms).  Without
# these as prerequisites the executables are rebuilt only when their own
# two files change, so an edit to the kernel they compile leaves a stale
# binary behind and the breakage is invisible: adding ThreadLocal to
# Context.sml went four days unnoticed here for exactly that reason,
# while a clean checkout failed immediately.
REPLAY_SRCS = $(shell mlton -stop f replay-test.mlb)
PFT_REPLAY_SRCS = $(shell mlton -stop f pft-replay-test.mlb)

replay-test: replay-test.mlb replay-test.sml $(REPLAY_SRCS)
	mlton -default-type intinf $<

pft-replay-test: pft-replay-test.mlb pft-replay-test.sml $(PFT_REPLAY_SRCS)
	mlton -default-type intinf $<

ifdef HAVE_WORD64
all: pft-replay-test replay-test
else
all: pft-replay-test
endif

else

$(info *** Doing nothing when no mlton)
all:
endif

EXTRA_CLEANS = replay-test pft-replay-test
