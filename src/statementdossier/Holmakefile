INCLUDES = $(HOLDIR)/tools/Holmake/toml

.PHONY: all
all: statementDossierLib.uo statementDossierConfig.uo selftest.exe \
     configSelftest.exe

ifdef POLY
all: statement-dossier

statement-dossier: statementDossierTool.uo $(dprot $(HOLDIR)/bin/hol.state)
	env HOL_CONFIG='' $(protect $(HOLDIR)/bin/hol) buildheap $< -o $@ --exe main
endif

selftest.exe: selftest.uo
	$(HOLMOSMLC) -o $@ $<

configSelftest.exe: configSelftest.uo
	$(HOLMOSMLC) -o $@ $<

ifdef HOLSELFTESTLEVEL
all: statementdossier-selftest.log statementdossier-config-selftest.log

statementdossier-selftest.log: selftest.exe
	$(tee ./selftest.exe 2>&1,$@)

statementdossier-config-selftest.log: configSelftest.exe
	$(tee ./configSelftest.exe 2>&1,$@)
endif

EXTRA_CLEANS = selftest.exe configSelftest.exe statement-dossier \
               statementdossier-selftest.log statementdossier-config-selftest.log
