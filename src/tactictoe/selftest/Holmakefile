all: $(DEFAULT_TARGETS) selftest.exe
.PHONY: all

selftest.exe: selftest.uo
	$(HOLMOSMLC) -o $@ $<

# ttt_record_thy decides the recording worked by looking for the tacdata
# file, so one left over from an earlier run makes this test pass without
# the recording having to succeed.  It must not survive a clean.
EXTRA_CLEANS = selftest.exe tactictoe2-selftest.log \
               $(HOLDIR)/src/tactictoe/ttt_tacdata/ConseqConv

ifdef HOLSELFTESTLEVEL
all: tactictoe2-selftest.log

tactictoe2-selftest.log: selftest.exe
	$(tee ./selftest.exe 2>&1, $@)

endif
