all: $(DEFAULT_TARGETS) selftest.exe
.PHONY: all

selftest.exe: selftest.uo
	$(HOLMOSMLC) -o $@ $<

# Points the recorder away from the user's real cache
# ($XDG_CACHE_HOME/tactictoe) so the selftest neither reads nor writes it.
SELFTEST_CACHE = $(HOLDIR)/src/tactictoe/selftest/.hol/tactictoe-cache

# Everything the selftest records lands under SELFTEST_CACHE, in the build
# tree rather than the user's cache, so a clean has to take it with it.
# The trailing / is what lets Holmake remove a directory, recursively.
EXTRA_CLEANS = selftest.exe tactictoe2-selftest.log $(SELFTEST_CACHE)/

ifdef HOLSELFTESTLEVEL
ifneq ($(HOLSELFTESTLEVEL),1)
all: tactictoe2-selftest.log

tactictoe2-selftest.log: selftest.exe
	$(tee env HOL4_TACTICTOE_CACHE=$(SELFTEST_CACHE) ./selftest.exe 2>&1, $@)

endif
endif
