INCLUDES = ..

all: $(DEFAULT_TARGETS)
.PHONY: all

# Theories that load another at run time wait for it through a stamp:
# depending on its .uo directly would link it in before the script runs.
.hol/runtime-loads.stamp: cvftleftTheory.uo cvftrightTheory.uo \
                          cvftrightdupTheory.uo cvftpickrightTheory.uo \
                          cvftbrokenTheory.uo cvftbothTheory.uo \
                          cvftpickdTheory.uo
	touch $@
cvftuse1Theory.sml cvftuse2Theory.sml cvftprec1Theory.sml \
cvftprec2Theory.sml cvftbroken1Theory.sml cvftbroken2Theory.sml \
cvftorderTheory.sml cvftpickd1Theory.sml \
cvftpickd2Theory.sml: .hol/runtime-loads.stamp

# cvftreplay reads it in, so Holmake does not see it
cvftreplayTheory.sml cvftorderTheory.sml: cvftreplay.ML

EXTRA_CLEANS = .hol/runtime-loads.stamp
