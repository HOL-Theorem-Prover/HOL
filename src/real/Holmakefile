INCLUDES = ../integer ../hol88 ../pred_set/src/more_theories \
           ../res_quan/src ../rational ../algebra

TARGETS = $(subst prove_real_assumsTheory.uo,,$(DEFAULT_TARGETS))

all:  selftest.exe $(TARGETS)
.PHONY: all

ifdef HOLBUILD
all: link-to-sigobj
.PHONY: link-to-sigobj

link-to-sigobj: $(TARGETS)
	$(HOL_LNSIGOBJ)
endif

selftest.exe: selftest.uo realSimps.uo NLArith.uo
	$(HOLMOSMLC) -o $@ $<

selftest_sos.exe: selftest_sos.uo SOSLib.uo
	$(HOLMOSMLC) -o $@ $<

EXTRA_CLEANS = selftest.exe selftest_sos.exe real-selftest.log sos-selftest.log

ifeq ($(KERNELID),otknl)
BARE_THYS = realax real intreal real_sigma metric nets
LOCAL_ARTS = $(patsubst %,%.ot.art,$(BARE_THYS))
# iterate now lives in src/pred_set/src
UPSTREAM_ARTS = ../pred_set/src/iterate.ot.art

base-theorems.art:
	opentheory info --theorems -o $@ real-1.61
	touch $(HOLOBJDIR)/base-theorems.ui $(HOLOBJDIR)/base-theorems.uo

hol4-real-unint.art: hol4-real-unint.thy $(LOCAL_ARTS) $(UPSTREAM_ARTS)
	opentheory info --article -o $@ $<

hol4-real-unsat.art: hol4-real-unsat.thy hol4-real-unint.art ../opentheory/hol4.int
	opentheory info --article -o $@ $<

# hol4-real-assums.thy composes the packages the real theories sit on top of,
# so those must be built first; string and n-bit share this build band.
INCLUDES += ../n-bit ../string
ASSUM_ARTS = ../boss/hol4-base.art ../string/hol4-string.art \
             ../n-bit/hol4-words.art ../integer/hol4-integer.art \
             ../res_quan/src/hol4-res-quan.art \
             ../pred_set/src/more_theories/hol4-set.art

hol4-real-assums.art: hol4-real-assums.thy hol4-real-unsat.art $(ASSUM_ARTS)
	opentheory info --skip-definitions --assumptions -o $@ $<
	touch $(HOLOBJDIR)/hol4-real-assums.ui
	touch $(HOLOBJDIR)/hol4-real-assums.uo

prove_real_assums.art: hol4-real-assums.art base-theorems.art

hol4-real.art: hol4-real.thy hol4-real-unsat.art prove_real_assums.ot.art ../opentheory/hol4.int
	opentheory info --article -o $@ $<

install: hol4-real.thy hol4-real.art
	opentheory install --reinstall $<

extreal_base.art: extreal_base.otd

all: hol4-real.art
endif

ifdef HOLSELFTESTLEVEL
all: real-selftest.log

real-selftest.log: selftest.exe
	$(tee ./$<, $@)

sos-selftest.log: selftest_sos.exe
	$(tee ./$<, $@)

endif
