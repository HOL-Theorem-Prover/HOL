ifdef POLY
CLINE_OPTIONS = --poly_not_hol
endif
all: $(DEFAULT_TARGETS)
.PHONY: all

ifdef POLY
ZEROSTATE = $(dprot $(HOLDIR)/bin/hol.state0)
MINSTATE = $(dprot $(HOLDIR)/bin/hol.state.min)
all: $(ZEROSTATE) $(MINSTATE)

BOOLTHEORY = $(dprot $(SIGOBJ)/boolTheory.uo)
BOOLLIB = $(dprot $(SIGOBJ)/boolLib.uo)
PRIMREC = $(dprot $(SIGOBJ)/Prim_rec.uo)
TERMPP = $(dprot $(SIGOBJ)/term_pp.uo)

# `Future' is here for `hol lsp', which used to `Meta.load' it at every
# server start: it is in sigobj but was in no heap, so it was read and
# linked again every time, costing 0.14s.  In a heap it costs nothing,
# `load' skipping whatever is already in `loadedMods'.
#
# This heap rather than boss's: the concurrent library is built long
# before here, every later heap is `-b' this one, and a `--bare'
# session -- which is how the LSP is developed -- gets it too.
# (`TacticParse' was the other half of that load; it is compiled into
# `bin/hol' itself now, so it needs no heap at all.)
DEPS = $(BOOLLIB) $(BOOLTHEORY) $(PRIMREC) $(TERMPP) \
       $(dprot $(SIGOBJ)/Future.uo) \
       proofManagerLib.uo History.uo \
       goalStack.uo goalTree.uo Manager.uo \
       $(dprot $(SIGOBJ)/UnicodeChars.uo) \
       $(dprot $(SIGOBJ)/ThmSetData.uo) \
       $(dprot $(SIGOBJ)/Pmatch.uo) \
       $(dprot $(SIGOBJ)/TypeBasePure.uo) \
       $(dprot $(SIGOBJ)/TypeBase.uo) \
       $(dprot $(SIGOBJ)/Preterm.uo) \
       $(dprot $(SIGOBJ)/type_pp.uo) \
       $(dprot $(SIGOBJ)/parse_term.uo) \
       $(dprot $(SIGOBJ)/ParseExtras.uo) \
       $(dprot $(SIGOBJ)/Drule.uo) \
       $(dprot $(SIGOBJ)/TheoryPP.uo) \
       $(dprot $(SIGOBJ)/Conv.uo) \
       $(dprot $(SIGOBJ)/Tactic.uo) \
       $(dprot $(SIGOBJ)/Tactical.uo) \
       $(dprot $(SIGOBJ)/ParseDatatype.uo) \
       $(dprot $(SIGOBJ)/type_grammar.uo) \
       $(dprot $(SIGOBJ)/Symtab.uo) \
       $(dprot $(SIGOBJ)/Inttab.uo) \
       $(dprot $(SIGOBJ)/KNametab.uo) \
       $(dprot $(SIGOBJ)/term_tokens.uo) \
       $(dprot $(SIGOBJ)/DB.uo) \
       $(dprot $(HOLDIR)/bin/hol)

UOARGS = $(protect $(SIGOBJ)/boolLib) proofManagerLib History goalStack \
         $(protect $(SIGOBJ)/KNametab) $(protect $(SIGOBJ)/Symtab) \
         $(protect $(SIGOBJ)/Inttab) $(protect $(SIGOBJ)/HOLsexp) \
	 $(protect $(SIGOBJ)/ThmSetData) $(protect $(SIGOBJ)/Future)

EXTRA_CLEANS = $(ZEROSTATE) $(MINSTATE)

$(ZEROSTATE): $(DEPS)
	$(protect $(HOLDIR)/bin/hol) buildheap $(DEBUG_FLAG) --poly -o $@ $(UOARGS) && \
	rm -f $(protect $(HOLDIR)/bin/hol.state)

$(MINSTATE): $(dprot $(HOLDIR)/bin/hol) $(dprot $(SIGOBJ)/HolKernel.uo)
	$(protect $(HOLDIR)/bin/hol) buildheap $(DEBUG_FLAG) --poly -o $@ \
	$(protect $(SIGOBJ)/HolKernel)
endif
