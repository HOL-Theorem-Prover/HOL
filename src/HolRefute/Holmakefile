ifdef POLY
# Keep refuteTheory's ancestry cv-free.  The selftest wrapper above runs
# refuteheap after the base and cv theories have been built separately.
HOLHEAP = $(HOLDIR)/bin/hol.state
EXTRA_CLEANS += refuteheap

REFUTE_DEPS = boss/bossLib n-bit/wordsLib sort/sortingTheory \
              real/realTheory \
              num/theories/cv_compute/automation/cv_transLib \
              num/theories/cv_compute/automation/cv_stdTheory
BARE_DEPS = $(patsubst %,../%,$(REFUTE_DEPS))
DEPS = $(patsubst %,%.uo,$(BARE_DEPS))

all: refuteheap selftest.exe

refuteheap: $(DEPS) refuteTheory.uo
	$(protect $(HOLDIR)/bin/hol) buildheap $(DEBUG_FLAG) -F -o $@ \
		-b $(dprot $(HOLDIR)/bin/hol.state) $(BARE_DEPS) refuteTheory
endif
