INCLUDES = $(HOLDIR)/src/portableML/poly/concurrent ../n-bit ../sort \
           ../real $(HOLDIR)/src/num/theories/cv_compute \
           $(HOLDIR)/src/num/theories/cv_compute/automation

all: $(DEFAULT_TARGETS) selftest.exe
.PHONY: all

selftest.uo: Refute_ModelFinder_Preproc.uo \
             Refute_ModelFinder_Kodkod.uo \
             Refute_ModelFinder_Model.uo \
             Refute_ModelFinder_Nut.uo \
             Refute_ModelFinder_Peephole.uo \
             Refute_ModelFinder_Rep.uo \
             Refute_ModelFinder_Scope.uo \
             Refute_ModelFinder_HOL.uo Refute_ModelFinder.uo \
             refuteTableZooTheory.uo

Refute_ModelFinder.uo: Refute_ModelFinder_Preproc.uo \
                       Refute_ModelFinder_Kodkod.uo \
                       Refute_ModelFinder_Model.uo \
                       Refute_ModelFinder_Nut.uo \
                       Refute_ModelFinder_Scope.uo \
                       Refute_ModelFinder_HOL.uo

Refute.uo: Refute_ModelFinder.uo

ifdef POLY
selftest.exe: selftest.uo refuteTheory.uo refute_cvTheory.uo \
              refuteTableZooTheory.uo refuteheap
	@printf '%s\n' '#!/bin/sh' 'set -e' \
	  '$(HOLDIR)/bin/hol --gcthreads=1 run \
	  --holstate=$(HOLDIR)/src/HolRefute/refuteheap selftest' \
	  'exit 0' > $@
	@chmod +x $@
else
selftest.exe: selftest.uo refuteTheory.uo refute_cvTheory.uo \
              refuteTableZooTheory.uo
	$(HOLMOSMLC) -o $@ $<
endif

ifdef HOLSELFTESTLEVEL
all: holrefute-selftest.log

FORL_GOLDENS = tests/forl-layout.kki tests/forl-expressions.kki \
               tests/forl-multi.kki tests/mf-kodkod-translation.kki
FORL_TRANSCRIPTS = tests/kodkodi-sat.stdout \
                   tests/kodkodi-unsat.stdout \
                   tests/kodkodi-batch.stdout \
                   tests/kodkodi-timeout.stdout \
                   tests/kodkodi-timeout.stderr \
                   tests/kodkodi-error.stdout \
                   tests/kodkodi-error.stderr

holrefute-selftest.log: selftest.exe $(FORL_GOLDENS) $(FORL_TRANSCRIPTS)
	$(tee ./selftest.exe 2>&1,$@)

ifdef POLY
ifneq ($(HOLSELFTESTLEVEL),0)
ifneq ($(HOLSELFTESTLEVEL),1)
all: theory-tests
.PHONY: theory-tests

theory-tests: selftest.exe
	$(HOLDIR)/bin/Holmake -C theory_tests --no_prereqs
endif
endif
endif
endif

EXTRA_CLEANS = selftest.exe holrefute-selftest.log

ifdef HOLBUILD
all: link-to-sigobj
.PHONY: link-to-sigobj
link-to-sigobj: $(DEFAULT_TARGETS)
	$(HOL_LNSIGOBJ)
endif

ifdef POLY
# Keep refuteTheory's ancestry cv-free.  The selftest wrapper above runs
# refuteheap after the base and cv theories have been built separately.
HOLHEAP = $(HOLDIR)/bin/hol.state
EXTRA_CLEANS += refuteheap

REFUTE_DEPS = boss/bossLib n-bit/wordsLib sort/sortingTheory \
              real/realTheory \
              num/theories/cv_compute/automation/cv_transLib \
              num/theories/cv_compute/automation/cv_stdTheory
BARE_DEPS = $(patsubst %,../%,$(REFUTE_DEPS))
DEPS = $(patsubst %,%.uo,$(BARE_DEPS))

all: refuteheap selftest.exe

refuteheap: $(DEPS) refuteTheory.uo
	$(protect $(HOLDIR)/bin/hol) buildheap $(DEBUG_FLAG) -F -o $@ \
		-b $(dprot $(HOLDIR)/bin/hol.state) $(BARE_DEPS) refuteTheory
endif
