# Multithreading, Future, Timeout and ParList come from
# src/portableML/poly/concurrent, which the kernel band builds with
# --poly_not_hol and links into sigobj.  Naming it in INCLUDES would make
# Holmake rebuild it here with the overlay in scope, and the resulting
# Sref -> Overlay dependency breaks the next kernel bootstrap in src/bool.
INCLUDES = ../n-bit ../sort \
           ../real ../coalgebras ../finite_maps \
           ../pred_set/src/more_theories

all: $(DEFAULT_TARGETS) build-tests build-loading-tests
.PHONY: all

# The selftest, the fixture theories it compiles against, and its
# goldens live in tests/.  Holmake rejects a parent that INCLUDEs its
# own subdirectory ("INCLUDES chain"), so the dependency runs the other
# way and that directory is driven recursively from here, as
# theory_tests/ and examples/ already are.  tests/ decides for itself
# whether HOLSELFTESTLEVEL means "build" or "build and run".
.PHONY: build-tests
# The child uses --no_prereqs, so its imports outside this directory must
# be ready before it starts.  INCLUDES makes these theories visible but
# does not order this recipe after their rebuilds in a parallel tree build.
build-tests: $(DEFAULT_TARGETS) \
             ../coalgebras/ltreeTheory.uo ../coalgebras/itreeTauTheory.uo \
             ../coalgebras/lbtreeTheory.uo ../coalgebras/pathTheory.uo \
             ../coalgebras/llistTheory.uo \
             ../pred_set/src/more_theories/finite_setTheory.uo
	$(HOLDIR)/bin/Holmake -C tests --no_prereqs

# Each loading test needs its own HOL process to observe independent theory
# imports, before either optional library has been loaded.
.PHONY: build-loading-tests
build-loading-tests: $(DEFAULT_TARGETS)
	$(HOLDIR)/bin/Holmake -C loading_tests/core --no_prereqs
	$(HOLDIR)/bin/Holmake -C loading_tests/rat --no_prereqs
	$(HOLDIR)/bin/Holmake -C loading_tests/real --no_prereqs
	$(HOLDIR)/bin/Holmake -C loading_tests/persistence --no_prereqs

# The substrate layer reaches the shared type/term helpers through a
# `structure Util = Refute_Util` alias, which holdep does not follow, so the
# dependency is declared explicitly.
Refute_Gen.uo: Refute_Util.uo
Refute_ModelFinder_Names.uo: Refute_Util.uo
Refute_ModelFinder_HOL.uo: Refute_Skolem.uo Refute_Util.uo \
                           Refute_RegistrationData.uo
Refute_Cert_Narrow.uo: Refute_Cert.uo Refute_Narrow.uo Refute_Util.uo \
                       Refute_ModelFinder_HOL.uo
Refute_Cert_Model.uo: Refute_Cert.uo Refute_Narrow.uo Refute_Util.uo \
                      Refute_ModelFinder_HOL.uo Refute_Skolem.uo
Refute_Narrow.uo: Refute_Util.uo Refute_Gen.uo Refute_ModelFinder_Names.uo
Refute_SmartGen.uo: Refute_Util.uo
# negative_candidates calls Refute_EvalEnum.negation_condition directly;
# none of Refute_QC's other prerequisites reach Refute_EvalEnum, so this
# edge is new, not a restatement of an existing transitive one.
Refute_QC.uo: Refute_Cert_Narrow.uo Refute_ModelFinder_HOL.uo \
              Refute_EvalEnum.uo
Refute_QC_Narrow.uo: Refute_QC.uo Refute_Narrow.uo
# The optional modules use aliases for model-finder helpers too.
Refute_Rat.uo: Refute_ModelFinder_HOL.uo
Refute_Real.uo: Refute_ModelFinder_HOL.uo Refute_ModelFinder_Util.uo \
                Refute_Util.uo

Refute_EvalEnum.uo: Refute_Util.uo
Refute_EvalCompute.uo: Refute_Util.uo Refute_EvalEnum.uo
Refute_EvalSML.uo: Refute_ModelFinder_Names.uo Refute_Util.uo
Refute_Extract.uo: Refute_Util.uo Refute_EvalEnum.uo

# Keep the foundational modules ahead of the FORL stack.  Refute_Forl
# reports its kodkodi errors through Refute_Core.Private, so that the
# warning a backend worker emits is serialized like every other one.
Refute_Forl.uo: Refute_ModelFinder_Util.uo Refute_PropSat.uo \
                Refute_Core.uo
Refute_ForlSat.uo: Refute_Forl.uo

# Keep Mono between HOL and Scope, matching the calculus dependency order.
Refute_ModelFinder_Mono.uo: Refute_PropSat.uo \
                            Refute_ModelFinder_Util.uo \
                            Refute_ModelFinder_HOL.uo
Refute_ModelFinder_Scope.uo: Refute_ModelFinder_Mono.uo
Refute_ModelFinder_Model.uo: Refute_Cert_Model.uo

Refute_ModelFinder.uo: Refute_ModelFinder_Preproc.uo \
                       Refute_ModelFinder_Kodkod.uo \
                       Refute_ModelFinder_Model.uo \
                       Refute_ModelFinder_Nut.uo \
                       Refute_ModelFinder_Scope.uo \
                       Refute_ModelFinder_Mono.uo \
                       Refute_ModelFinder_HOL.uo Refute_Cert.uo \
                       Refute_Skolem.uo

# The unused-assumption engine is kept below the facade so its probes can
# call the core without introducing a Refute -> Refute_Unused cycle.
Refute_Unused.uo: Refute_Core.uo
Refute.uo: Refute_Unused.uo Refute_ModelFinder.uo Refute_QC_Narrow.uo

