    (fn (structure_name, entry, _) =>
      "let val hole = " ^ structure_name ^ ".refute_hole [12, 0]\n" ^
      "in not (Susp.force (Susp.force (" ^ entry ^ ") hole)) end")

fun lazy_generated_field_keeps_path () =
