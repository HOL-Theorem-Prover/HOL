     |> mf_with_verdict_policy MfCertifiedGenuine,
   mf_acceptance_invocation "Relation mono: O argument order"
     ``~zoo_bool_relcomp
         (\b : bool. \n : num. b /\ n = 1)
         (\n : num. \b : bool. n = 0 /\ b) 0 1``
