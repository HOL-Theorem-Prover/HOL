    case exhaustive default_config goal of
        Counterexample
          ({certainty = Genuine, cert = SOME theorem, ...} :: _) =>
            certifies_negated_closure goal theorem
      | _ => false))
    (fn () => name ^ " did not produce the expected certificate theorem")
    (fn () => ()) ()

