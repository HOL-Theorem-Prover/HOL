val auto_ho_custom : custom_gen =
  {enumerate = SOME (fn _ =>
     [``\x : rg_enum. T``, ``\x : rg_enum. F``]),
   random = SOME (fn _ => fn state =>
     let val (choice, next) = rand_below 2 state
     in
       (if choice = 0 then ``\x : rg_enum. T``
        else ``\x : rg_enum. F``, next)
     end)}
