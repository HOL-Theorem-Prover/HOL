    ExpectNone, MfCertIgnored, false),
   ("22 insufficient int addition premise",
    ``x >= 0 ==> x + y >= (x : int)``,
    ExpectGenuine, MfCertSome, false),
   ("23 nonpositive int addition",
    ``(x <= 0 /\ y <= 0) ==> x + y <= (0 : int)``,
