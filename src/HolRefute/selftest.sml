   ("24 nonzero int is not positive",
    ``y <> 0 ==> x + y > (x : int)``,
    ExpectGenuine, MfCertSome, false),
   ("25 int addition commutes", ``x + y = y + (x : int)``,
    ExpectNone, MfCertIgnored, false),
   ("26 positive int subtraction",
    ``x > y ==> x - y <> (0 : int)``,
    ExpectNone, MfCertIgnored, false),
   ("27 int subtraction is not truncated",
    ``x <= y ==> x - y = (0 : int)``,
    ExpectGenuine, MfCertSome, false),
