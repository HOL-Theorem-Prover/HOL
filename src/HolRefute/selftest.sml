      "let val hole = " ^ structure_name ^ ".refute_hole [12, 1]\n" ^
      "in (Susp.force (Susp.force (" ^ entry ^ ") hole); false)\n" ^
      "   handle Refute_EvalSML.Hole position =>\n" ^
