    val first = Refute.try_refute config ([], ``(x : num) = 0``)
    val second = Refute.try_refute config ([], ``(x : num) = 0``)
  in
    case (first, second) of
        (SOME ("random", Refute.Counterexample [left]),
         SOME ("random", Refute.Counterexample [right])) =>
