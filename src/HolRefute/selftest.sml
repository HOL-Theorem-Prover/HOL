fun cv_ancestry_is_separate () =
  same_string_set (Theory.parents "refute")
    ["real", "sorting", "words", "rat"] andalso
  same_string_set (Theory.parents "refute_cv") ["refute", "cv_std"] andalso
  not (Lib.mem "cv_std" (Theory.ancestry "refute"))

