    eval_cfun_shape))
  (fn () => "narrowing evaluator equations: " ^
    Parse.term_to_string (Thm.concl eval_ffun_compute) ^ " versus " ^
    Parse.term_to_string eval_ffun_shape ^ "; " ^
    Parse.term_to_string (Thm.concl eval_cfun_compute) ^ " versus " ^
