    val backend : backend =
      {name = "narrowing", weight = 40, configured = fn () => true,
       requires = AnyGoal,
       input = MonoInstances,
       run = fn config => fn _ =>
         (selected := #backends config = SOME ["narrowing"];
          Unknown ["narrowing tactic pin"])}
  in
