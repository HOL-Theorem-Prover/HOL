  in
    untouched
      ``\xs : num list. NULL [case xs of [] => 0 | h :: t => h]`` andalso
    untouched ``\xs : num list. NULL [(\ys. HD ys) xs]`` andalso
    untouched ``\xs : num list. NULL [rx_sum xs]``
  end

