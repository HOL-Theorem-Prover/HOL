fun all_extraction_goldens () =
  let
    fun check [] = true
      | check (term :: terms) =
          if extraction_agrees term then check terms
          else raise Fail ("extraction mismatch: " ^ Parse.term_to_string term)
  in
    check extraction_goldens
  end

