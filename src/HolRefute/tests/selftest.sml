    val plan = Gen (variable, Test boolSyntax.T)
    val arguments = {plan = plan, seed = 7 : IntInf.int, size = 5, count = 6}
  in
    same_candidate_stream (dump_random_candidates arguments)
      (reference_rat_stream 5 7 6)
  end

