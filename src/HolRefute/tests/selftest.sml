    ?b1 : num.
    ?b2 b3 b4 b5 b6 b7 b8 b9 b10 : 'a.
    ?b11 : num.
      b1 < b11 /\
      zoo_special_f5 g x =
      zoo_special_f5 (\a. if b1 < b11 then a else h b2) x``
val mf_special_20 =
  ``(!a : num. g a = a) ==>
    ?b1 : num.
    ?b2 b3 b4 b5 b6 b7 b8 b9 b10 : 'a.
    ?b11 : num.
      b1 < b11 /\
      g x =
        (if b1 < b11 then x else
          h b2 + h b3 + h b4 + h b5 + h b6 +
