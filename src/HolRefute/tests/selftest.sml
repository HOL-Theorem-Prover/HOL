    (case result of
         Counterexample (cex :: _) => #substrate cex = "native"
       | _ => false) andalso
    has_binding (fn (_, value) =>
      case Lib.total listSyntax.dest_list value of
          SOME (values, _) => length values >= 2 andalso
            not (Term.aconv (hd values) (List.nth (values, 1)))
        | NONE => false) result
  end

