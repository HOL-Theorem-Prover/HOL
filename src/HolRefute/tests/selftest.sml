  {name = "refute-unused-sequential-sweep", weight = ~87,
   configured = unused_sweep_enabled,
   requires = AnyGoal,
   input = MonoInstances,
   run = fn _ => fn _ =>
     let
       val _ = enter_unused_sweep ()
       fun probe () =
         (OS.Process.sleep (Time.fromReal 0.02); NoCounterexample)
     in
       Portable.finally leave_unused_sweep probe ()
     end}

