    ``∀n : num. n ≤ 5 ∧ 2 < n ⇒ n ≠ 2``, boolSyntax.T),
   (* Exists half of the same swap coverage, [lo] endpoint only, mirroring
      the [forall-interval-*-swap] cases above. *)
   ("exists-interval-leq-lt-swap", bounded_exists_interval_leq_lt_swap,
