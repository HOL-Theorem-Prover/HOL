// HOL4 Refute FORL golden
// fixed timestamp

// sound
// codatatype bisimulation
solver: "DefaultSAT4J"
bit_width: 16
symmetry_breaking: 15
sharing: 3
flatten: false
delay: 0
univ: u4
bounds r3' /* suc */: {P11}
bounds s0 /* xs : A2 */, s1 /* ys : A2 */, s2 /* llist$LCONS : A2 => F= */: [{}, u2]
bounds m3_0 /* refute$bisim : A2@2 => A2 => A2 => F= */: [{}, u2@2->u2->u2]
bounds s4 /* refute$bisim_iterator_max : A2@2 */: {[A3]}
bounds r0 /* llist$LCONS : A2 => A2@2 */: [{}, u2->u2@2]
bounds r1 /* llist$LCONS : A2 => A2 */: [{}, u2->u2]
bounds s3 /* llist$LNIL : A2 => F= */: [{}, u1]
int_bounds: [{[A0]}, {[A1]}, {[A2]}, {[A3]}]
solve one s0
   && one s1
   && one s4
   && (all [S0 : one u2] | if S0 in s2 then all [] | one S0.r0 else no S0.r0)
   && (all [S0 : one u2] | if S0 in s2 then all [] | one S0.r1 else no S0.r1)
   && (all [S0 : one s2, S1 : one s2] | S0.r0 = S1.r0 && S0.r1 = S1.r1 => S0 = S1)
   && lone s3
   && s2 + s3 = u2
   && no s2 & s3
   && true
   && (if s1 in s0.(A2.m3_0) then A3 else A2) = A3
   && s1.(s0.(if no A2.(r3' & univ->u2@2) then none->none->none else {[S0' : one u2, S1' : one u2, S2' : one u2@2] | (S1'->S2').A3 = S0'.(A2.(r3' & univ->u2@2).m3_0)})) = A3
   && s1.(s0.(if no {[S0 : one u2@2, S0' : one u2@2] | S0' in (if S0.(r3' & univ->u2@2) = s4 then A3 else none) + (if lone S0.(r3' & univ->u2@2) + s4 then none else A2)}.A3 then none->none->none else {[S0' : one u2, S1' : one u2, S2' : one u2@2] | (S1'->S2').A3 = S0'.({[S0 : one u2@2, S0' : one u2@2] | S0' in (if S0.(r3' & univ->u2@2) = s4 then A3 else none) + (if lone S0.(r3' & univ->u2@2) + s4 then none else A2)}.A3.m3_0)})) = A3
   && (if s1 in s0.(s4.m3_0) then A3 else A2) = A3;
