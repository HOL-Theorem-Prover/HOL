// HOL4 Refute FORL golden
// fixed timestamp

// sound
// ¬(SUC n + m − m * n DIV 2 < 260 ∧ i * j / 2 + i − j < i ∧ &m < i ∧ Num j < n)
solver: "DefaultSAT4J"
bit_width: 10
symmetry_breaking: 15
sharing: 3
flatten: false
delay: 0
univ: u19
bounds s0 /* n : A4 */, s1 /* m : A4 */: [{}, u4]
bounds s2 /* i : A5@4 */, s3 /* j : A5@4 */: [{}, u5@4]
bounds s4 /* refute$Bitword : A5@4 => F= */: u5@4
bounds r2' /* refute$Bitword : A5@4 => A10@9 => F= */: [{}, u5@4->u10@9]
bounds s5 /* refute$Bitword : A4 => F= */: u4
bounds r1' /* refute$Bitword : A4 => A9@9 => F= */: [{}, u4->u9@9]
int_bounds: 1: [{[A9]}], 2: [{[A10]}], 4: [{[A11]}], 8: [{[A12]}], 16: [{[A13]}], 32: [{[A14]}], 64: [{[A15]}], 128: [{[A16]}], 256: [{[A17]}], -512: [{[A18]}]
solve one s0
   && one s1
   && one s2
   && one s3
   && (all [S0 : one s5, S1 : one s5] | S0.r1' = S1.r1' => S0 = S1)
   && (all [S0 : one s4, S1 : one s4] | S0.r2' = S1.r2' => S0 = S1)
   && ((let [$e0 := {[S0' : one u4] | S0'.r1' = Bits[2]}.(s0.(s1.{[S0 : one u4, S1 : one u4, S2 : one u4] | let [$i0 := sum(S0.r1'), $i1 := sum(S1.r1'), $i2 := sum(S2.r1')] | ($i1 = 0 || $i2 / $i1 = $i0) && $i2 = $i0 * $i1}).{[S0 : one u4, S1 : one u4, S2 : one u4] | let [$i0 := sum(S0.r1'), $i1 := sum(S1.r1'), $i2 := sum(S2.r1')] | $i2 = (if $i1 = 0 then 0 else $i0 / $i1)}).(s1.(s0.{[S0 : one u4, S1 : one u4] | let [$i0 := sum(S0.r1'), $i1 := sum(S1.r1')] | $i1 = 1 + $i0}.{[S0 : one u4, S1 : one u4, S2 : one u4] | let [$i0 := sum(S0.r1'), $i1 := sum(S1.r1'), $i2 := sum(S2.r1')] | $i2 = $i0 + $i1}).{[S0 : one u4, S1 : one u4, S2 : one u4] | let [$i0 := sum(S0.r1'), $i1 := sum(S1.r1'), $i2 := sum(S2.r1')] | $i2 = (if $i0 <= $i1 then 0 else $i0 - $i1)})] | let [$e1 := {[S0' : one u4] | S0'.r1' = Bits[260]}] | some $e0 && some $e1 && ! sum($e0.r1') < sum($e1.r1')) || (let [$e0 := s3.(s2.({[S0' : one u5@4] | S0'.r2' = Bits[2]}.(s3.(s2.{[S0 : one u5@4, S1 : one u5@4, S2 : one u5@4] | let [$i0 := sum(S0.r2'), $i1 := sum(S1.r2'), $i2 := sum(S2.r2')] | ($i1 = 0 || $i2 / $i1 = $i0 && 0 <= $i0 & $i1 & $i2) && $i2 = $i0 * $i1}).{[S0 : one u5@4, S1 : one u5@4, S2 : one u5@4] | let [$i0 := sum(S0.r2'), $i1 := sum(S1.r2'), $i2 := sum(S2.r2')] | 0 <= $i0 & $i1 & $i2 && $i2 = (if $i0 < 0 && 0 < $i1 then ($i0 + 1) / $i1 - 1 else if 0 < $i0 && $i1 < 0 then ($i0 - 1) / $i1 - 1 else if $i1 = 0 then 0 else $i0 / $i1)}).{[S0 : one u5@4, S1 : one u5@4, S2 : one u5@4] | let [$i0 := sum(S0.r2'), $i1 := sum(S1.r2'), $i2 := sum(S2.r2')] | (0 <= $i0 ^ $i1 => 0 <= $i1 ^ $i2) && $i2 = $i0 + $i1}).{[S0 : one u5@4, S1 : one u5@4, S2 : one u5@4] | let [$i0 := sum(S0.r2'), $i1 := sum(S1.r2'), $i2 := sum(S2.r2')] | ($i0 ^ $i1 < 0 => $i1 ^ $i2 < 0) && $i2 = $i0 - $i1})] | some $e0 && ! sum($e0.r2') < sum(s2.r2')) || (let [$e0 := s1.{[S0 : one u4, S1 : one u5@4] | let [$i0 := sum(S0.r1'), $i1 := sum(S1.r2')] | $i1 = $i0}] | some $e0 && ! sum($e0.r2') < sum(s2.r2')) || (let [$e0 := s3.{[S0 : one u5@4, S1 : one u4] | let [$i0 := sum(S0.r2'), $i1 := sum(S1.r1')] | $i1 = (if $i0 < 0 then 0 - $i0 else $i0)}] | some $e0 && ! sum($e0.r1') < sum(s0.r1')));
