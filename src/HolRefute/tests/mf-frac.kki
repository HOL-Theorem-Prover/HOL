// HOL4 Refute FORL golden
// fixed timestamp

// sound
// Frac (norm_frac i j) ∧ nat_gcd n m = nat_lcm n m
solver: "DefaultSAT4J"
bit_width: 16
symmetry_breaking: 15
sharing: 3
flatten: false
delay: 0
univ: u3
bounds m3_11' /* lcm */: {T3_0, T3_3, T3_6, T3_9, T3_13, T3_17, T3_18, T3_23, T3_26}
bounds m3_10' /* gcd */: {T3_0, T3_4, T3_8, T3_10, T3_13, T3_16, T3_20, T3_22, T3_26}
bounds m4_0' /* norm_frac */: {T4_1, T4_10, T4_19, T4_28, T4_40, T4_52, T4_55, T4_70, T4_76}
bounds s0 /* i : A3 */, s1 /* j : A3 */, s2 /* n : A3 */, s3 /* m : A3 */: [{}, u3]
int_bounds: [{[A0]}, {[A1]}, {[A2]}]
solve one s0
   && one s1
   && one s2
   && one s3
   && some s1.(s0.m4_0')
   && s1.(s0.m4_0') in m4_0'[2, 3]
   && s3.(s2.m3_10') = s3.(s2.m3_11');
