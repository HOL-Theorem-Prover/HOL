CLINE_OPTIONS = --no_prereqs
INCLUDES = ../..

all: $(DEFAULT_TARGETS) early.exe late.exe descendant.exe diamond.exe \
     diamond_early.exe conflict.exe cross.exe bad_version.exe preferred.exe
.PHONY: all

early.exe: early.uo refutePersistTheory.uo
	@printf '%s\n' '#!/bin/sh' 'set -e' \
	  '$(HOLDIR)/bin/hol --gcthreads=1 run early' > $@
	@chmod +x $@

# No static Refute dependency: checks load after the explicit runtime loads.
