# Test-only directory: the selftest, the smoke and their shared helpers
# (hhTestLib, which ../evaluation uses too).  The build sequence names it
# with "!", so bin/build builds it only for selftests and never installs
# its modules in sigobj.
INCLUDES = ..

all: $(DEFAULT_TARGETS) selftest.exe smoke.exe
.PHONY: all

selftest.exe: selftest.uo
	$(HOLMOSMLC) -o $@ $<

smoke.exe: smoke.uo
	$(HOLMOSMLC) -o $@ $<

EXTRA_CLEANS = selftest.exe selftest.log smoke.exe

ifdef HOLSELFTESTLEVEL
all: selftest.log

selftest.log: selftest.exe
	$(tee (d=$$(mktemp -d); HOL4_HAMMER_DIR=$$d HOL4_SCRATCH=$$d/scratch ./selftest.exe 2>&1; s=$$?; rm -rf $$d; exit $$s),$@)

endif
