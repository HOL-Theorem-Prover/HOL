(* BLS12-381 G1: the base-field curve and its prime-order subgroup.

   Documentation
   The equation is y^2 = x^3 + 4 over bls12381_base_field. Coordinates are
   natural-number residues; points are ECAffine x y or ECInfinity.
   namedPrimeFields supplies the base-field and scalar-primality results.

   Definitions: bls12381_g1_a_def, bls12381_g1_b_def,
   bls12381_g1_generator_def, bls12381_g1_group_def (all rational points),
   bls12381_g1_subgroup_def (Generated by the standard generator).

   Curve and membership: bls12381_g1_curve, bls12381_g1_generator_member,
   bls12381_g1_finite_group.
   Generator and subgroup: bls12381_g1_generator_annihilated,
   bls12381_g1_generator_order, bls12381_g1_subgroup_is_subgroup,
   bls12381_g1_subgroup_cyclic, bls12381_g1_subgroup_card.

   The subgroup cardinality is bls12381_n, not the full curve cardinality.
   bls12381Cardinality supplies the full cofactor and the distinction. *)

Theory bls12381G1Instance
Ancestors
  namedPrimes
  namedPrimeFields ellipticCertificates ellipticTorsion fieldInstances
  shortWeierstrass shortWeierstrassGroup
Libs
  ellipticCertificateLib

(* Standard affine parameters; no executable Verifereum arithmetic is imported. *)
Definition bls12381_g1_a_def:
  bls12381_g1_a :num = 0
End

Definition bls12381_g1_b_def:
  bls12381_g1_b :num = 4
End

Definition bls12381_g1_generator_def:
  bls12381_g1_generator = ECAffine (3685416753713387016781088315183077757961620795782546409894578378688607592378376318836054947676345821548104185464507:num) (1339506544944476473020471379941921221584933875938349620426543736416511423956333506472724655353366534992391756441569:num)
End

Definition bls12381_g1_group_def:
  bls12381_g1_group = sw_group bls12381_base_field bls12381_g1_a bls12381_g1_b
End

Definition bls12381_g1_subgroup_def:
  bls12381_g1_subgroup = Generated bls12381_g1_group bls12381_g1_generator
End

Theorem bls12381_g1_curve:
  ShortWeierstrassCurve bls12381_base_field bls12381_g1_a bls12381_g1_b
Proof
  REWRITE_TAC [ShortWeierstrassCurve_def] >>
  REWRITE_TAC [bls12381_base_field_field, bls12381_base_field_char] >>
  REWRITE_TAC [bls12381_base_field_def, bls12381_g1_a_def,
    bls12381_g1_b_def, bls12381_p_def, sw_discriminant_def,
    GF_eval, GF_sum_inv, monoidTheory.monoid_exp_def] >>
  CONV_TAC (certificateComputeLib.EVAL_CONV ())
QED

Theorem bls12381_g1_generator_member:
  bls12381_g1_generator IN sw_points bls12381_base_field bls12381_g1_a bls12381_g1_b
Proof
  REWRITE_TAC [sw_points_member, sw_on_curve_def, sw_curve_rhs_def,
    bls12381_base_field_def, bls12381_p_def, bls12381_g1_a_def,
    bls12381_g1_b_def, bls12381_g1_generator_def, GF_eval,
    monoidTheory.monoid_exp_def] >>
  CONV_TAC (certificateComputeLib.EVAL_CONV ())
QED

Theorem bls12381_g1_finite_group:
  FiniteAbelianGroup bls12381_g1_group
Proof
  rw[bls12381_g1_group_def] >>
  irule short_weierstrass_finite_group >>
  simp[bls12381_g1_curve, bls12381_base_field_finite_field]
QED

local
    val definitions = [bls12381_g1_group_def, bls12381_base_field_def, bls12381_p_def, bls12381_g1_a_def, bls12381_g1_b_def, bls12381_g1_generator_def, bls12381_n_def]
    fun numeric th = CONV_RULE certificateComputeLib.NAT_CONV
      (REWRITE_RULE definitions th)
    val prime = numeric bls12381_p_prime
    val curve = numeric bls12381_g1_curve
    val member = numeric bls12381_g1_generator_member
    val step = ellipticCertificateLib.SCALAR_STEP_TAC prime curve member
in
  val bls12381_g1_scalar_normalize = CONV_TAC (LAND_CONV
    (REWRITE_CONV definitions THENC certificateComputeLib.NAT_CONV))
  val bls12381_g1_scalar_certificate =
    ellipticCertificateLib.SCALAR_CERTIFICATE_TAC 4 prime curve member
  val bls12381_g1_scalar_step = step
end

Theorem bls12381_g1_generator_annihilated:
  bls12381_g1_group.exp bls12381_g1_generator bls12381_n = ECInfinity
Proof
  bls12381_g1_scalar_normalize >>
  bls12381_g1_scalar_certificate
  >| [bls12381_g1_scalar_step, bls12381_g1_scalar_step,
      bls12381_g1_scalar_step, bls12381_g1_scalar_step,
      bls12381_g1_scalar_step, bls12381_g1_scalar_step,
      bls12381_g1_scalar_step, bls12381_g1_scalar_step,
      bls12381_g1_scalar_step, bls12381_g1_scalar_step,
      bls12381_g1_scalar_step, bls12381_g1_scalar_step,
      bls12381_g1_scalar_step, bls12381_g1_scalar_step,
      bls12381_g1_scalar_step, bls12381_g1_scalar_step,
      bls12381_g1_scalar_step, bls12381_g1_scalar_step,
      bls12381_g1_scalar_step, bls12381_g1_scalar_step,
      bls12381_g1_scalar_step, bls12381_g1_scalar_step,
      bls12381_g1_scalar_step, bls12381_g1_scalar_step,
      bls12381_g1_scalar_step, bls12381_g1_scalar_step,
      bls12381_g1_scalar_step, bls12381_g1_scalar_step,
      bls12381_g1_scalar_step, bls12381_g1_scalar_step,
      bls12381_g1_scalar_step, bls12381_g1_scalar_step,
      bls12381_g1_scalar_step, bls12381_g1_scalar_step,
      bls12381_g1_scalar_step, bls12381_g1_scalar_step,
      bls12381_g1_scalar_step, bls12381_g1_scalar_step,
      bls12381_g1_scalar_step, bls12381_g1_scalar_step,
      bls12381_g1_scalar_step, bls12381_g1_scalar_step,
      bls12381_g1_scalar_step, bls12381_g1_scalar_step,
      bls12381_g1_scalar_step, bls12381_g1_scalar_step,
      bls12381_g1_scalar_step, bls12381_g1_scalar_step,
      bls12381_g1_scalar_step, bls12381_g1_scalar_step,
      bls12381_g1_scalar_step, bls12381_g1_scalar_step,
      bls12381_g1_scalar_step, bls12381_g1_scalar_step,
      bls12381_g1_scalar_step, bls12381_g1_scalar_step,
      bls12381_g1_scalar_step, bls12381_g1_scalar_step,
      bls12381_g1_scalar_step, bls12381_g1_scalar_step,
      bls12381_g1_scalar_step, bls12381_g1_scalar_step,
      bls12381_g1_scalar_step, bls12381_g1_scalar_step]
QED

Theorem bls12381_g1_generator_order:
  order bls12381_g1_group bls12381_g1_generator = bls12381_n
Proof
  rw[bls12381_g1_group_def] >>
  irule sw_prime_generator_order >>
  simp[bls12381_g1_curve, bls12381_g1_generator_member, bls12381_n_prime,
       bls12381_g1_generator_def,
       REWRITE_RULE [bls12381_g1_group_def] bls12381_g1_generator_annihilated]
QED

Theorem bls12381_g1_subgroup_is_subgroup:
  Subgroup bls12381_g1_subgroup bls12381_g1_group
Proof
  rw[bls12381_g1_subgroup_def, bls12381_g1_group_def] >>
  irule sw_generated_subgroup >>
  simp[bls12381_g1_curve, bls12381_g1_generator_member, bls12381_base_field_finite_field]
QED

Theorem bls12381_g1_subgroup_cyclic:
  cyclic bls12381_g1_subgroup
Proof
  rw[bls12381_g1_subgroup_def, bls12381_g1_group_def] >>
  irule sw_generated_cyclic >>
  simp[bls12381_g1_curve, bls12381_g1_generator_member, bls12381_base_field_finite_field]
QED

Theorem bls12381_g1_subgroup_card:
  CARD bls12381_g1_subgroup.carrier = bls12381_n
Proof
  rw[bls12381_g1_subgroup_def] >>
  `0 < bls12381_n` by metis_tac[bls12381_n_prime, dividesTheory.ONE_LT_PRIME,
                                      arithmeticTheory.LESS_TRANS, DECIDE ``(0:num) < 1``] >>
  metis_tac[sw_generator_card, bls12381_g1_curve, bls12381_g1_generator_member,
            bls12381_g1_group_def, bls12381_g1_generator_order]
QED

