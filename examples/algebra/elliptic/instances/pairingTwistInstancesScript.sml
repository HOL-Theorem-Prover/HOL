(* BN254 and BLS12-381 G2: quadratic-field twists and their generators.

   Documentation
   Points use ECAffine/ECInfinity over the PolyModRing fields bn254_fp2
   and bls12381_fp2. Lists are ascending coefficients in i, with i^2 = -1;
   [] is zero. The equations have a = 0 and b = 3/(9+i) or 4+4*i.
   The named prime and quadratic-field facts are imported, not assumed
   from an external arithmetic implementation.

   For each prefix bn254_g2 and bls12381_g2:
   Definitions: *_a_def, *_b_def, *_generator_def, *_group_def,
   *_subgroup_def. The group contains all twist rational points;
   the subgroup is Generated by the standard generator.
   Curve and membership: *_curve, *_generator_member, *_finite_group.
   Generator and subgroup: *_generator_annihilated, *_generator_order,
   *_subgroup_is_subgroup, *_subgroup_cyclic, *_subgroup_card.
   Coefficient normalization: bn254_g2_twist_coefficient.

   Generator order and subgroup cardinality equal the named scalar prime;
   full G2 cardinalities and cofactors belong to the cardinality theories,
   not to these generator certificates. *)

Theory pairingTwistInstances
Ancestors
  namedPrimes
  namedPrimeFields pairingQuadraticFields ellipticCertificates ellipticTorsion
  shortWeierstrass shortWeierstrassGroup polynomialCertificate
  polyModuloRing fieldInstances
Libs
  pairingCurveCertificateLib

(* All lists use ascending coefficients: [real;imaginary] represents
   real + imaginary*i, where i^2 = -1.  The canonical zero is [].
   These are the quadratic PolyModRing fields, not tuple implementations.
   BN254 b is the normalized residue of 3/(9+i); BLS12-381 b is 4+4i. *)

(* Each explicit certificate chunk prepares at most sixteen binary bits.
   Doubling and odd-bit addition then have separate kernel-checked branches,
   preserving the default tactic timeout for preparation as well as checking. *)
fun pairing_scalar_certificate_tac defs prime field curve member goal =
  let fun numeric th = REWRITE_RULE defs th in
    pairingCurveCertificateLib.SCALAR_CERTIFICATE_TAC
      (numeric prime) (numeric field) (numeric curve) (numeric member) goal
  end

fun pairing_scalar_step_tac defs prime field curve member goal =
  let fun numeric th = REWRITE_RULE defs th in
    pairingCurveCertificateLib.SCALAR_STEP_TAC
      (numeric prime) (numeric field) (numeric curve) (numeric member) goal
  end

Definition bn254_g2_a_def:
  bn254_g2_a :num list = []
End

Definition bn254_g2_b_def:
  bn254_g2_b = [19485874751759354771024239261021720505790618469301721065564631296452457478373n;266929791119991161246907387137283842545076965332900288569378510910307636690n]
End

Definition bn254_g2_generator_def:
  bn254_g2_generator = ECAffine [10857046999023057135944570762232829481370756359578518086990519993285655852781n;11559732032986387107991004021392285783925812861821192530917403151452391805634n] [8495653923123431417604973247489272438418190587263600148770280649306958101930n;4082367875863433681332203403145435568316851327593401208105741076214120093531n]
End

Definition bn254_g2_group_def:
  bn254_g2_group = sw_group bn254_fp2 bn254_g2_a bn254_g2_b
End

Definition bn254_g2_subgroup_def:
  bn254_g2_subgroup = Generated bn254_g2_group bn254_g2_generator
End

Theorem bn254_g2_field[local]:
  Field bn254_fp2
Proof
  metis_tac[bn254_fp2_finite_field, fieldTheory.FiniteField_def]
QED
Theorem bn254_g2_twist_coefficient:
  bn254_fp2.prod.op bn254_g2_b [9;1] = [3]
Proof
  let
    val defs = [bn254_fp2_def, bn254_fp2_poly_def, bn254_p_def,
                bn254_g2_b_def]
    val prime = REWRITE_RULE defs bn254_p_prime
    val field = REWRITE_RULE defs bn254_g2_field
  in CONV_TAC (REWRITE_CONV defs THENC
       pairingCurveCertificateLib.FIELD_CONV prime field) end
QED


Theorem bn254_g2_curve:
  ShortWeierstrassCurve bn254_fp2 bn254_g2_a bn254_g2_b
Proof
  rw[ShortWeierstrassCurve_def, bn254_g2_field, bn254_fp2_char] >>
  let
    val defs = [bn254_fp2_def, bn254_fp2_poly_def, bn254_p_def,
                bn254_g2_a_def, bn254_g2_b_def, sw_discriminant_def]
    val prime = REWRITE_RULE defs bn254_p_prime
    val field = REWRITE_RULE defs bn254_g2_field
  in CONV_TAC (REWRITE_CONV defs THENC
       pairingCurveCertificateLib.FIELD_CONV prime field) end
QED

Theorem bn254_g2_generator_member:
  bn254_g2_generator IN sw_points bn254_fp2 bn254_g2_a bn254_g2_b
Proof
  let
    val defs = [bn254_fp2_def, bn254_fp2_poly_def, bn254_p_def,
                bn254_g2_a_def, bn254_g2_b_def, bn254_g2_generator_def,
                sw_points_member, sw_on_curve_def, sw_curve_rhs_def]
    val prime = REWRITE_RULE defs bn254_p_prime
    val field = REWRITE_RULE defs bn254_g2_field
  in CONV_TAC (REWRITE_CONV defs THENC
       pairingCurveCertificateLib.FIELD_CONV prime field) end
QED

Theorem bn254_g2_finite_group:
  FiniteAbelianGroup bn254_g2_group
Proof
  rw[bn254_g2_group_def] >>
  irule short_weierstrass_finite_group >>
  simp[bn254_g2_curve, bn254_fp2_finite_field]
QED

val bn254_g2_scalar_defs =
  [bn254_g2_group_def, bn254_fp2_def, bn254_fp2_poly_def,
   bn254_p_def, bn254_n_def, bn254_g2_a_def,
   bn254_g2_b_def, bn254_g2_generator_def]

fun bn254_g2_scalar_certificate_tac goal =
  pairing_scalar_certificate_tac bn254_g2_scalar_defs
    bn254_p_prime bn254_g2_field bn254_g2_curve bn254_g2_generator_member goal

fun bn254_g2_scalar_step_tac goal =
  pairing_scalar_step_tac bn254_g2_scalar_defs
    bn254_p_prime bn254_g2_field bn254_g2_curve bn254_g2_generator_member goal

