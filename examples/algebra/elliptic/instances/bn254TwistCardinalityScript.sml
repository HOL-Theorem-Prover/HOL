(* BN254 G2: full twist cardinality, cofactor and a full-order point.

   Documentation
   The curve is the quadratic-field twist y^2 = x^3 + 3/(9+i), i^2 = -1,
   represented by normalized coefficient lists in bn254_fp2. A certified
   full-order point, absence of nonidentity two-torsion, and the elementary
   point bound determine the rational-point count.

   Definitions: bn254_g2_full_cofactor_def (2*p - n),
   bn254_g2_full_order_def, bn254_g2_full_generator_def.
   Order: bn254_g2_full_generator_scalar_tests,
   bn254_g2_full_generator_order.
   Cardinality: bn254_g2_cardinality, bn254_g2_group_cardinality,
   bn254_g2_full_cofactor_relation, bn254_g2_prime_subgroup_is_proper.
   Clearing: bn254_g2_cofactor_clearing,
   bn254_g2_full_generator_cofactor_order.

   The full-order certificate point is distinct from the standard
   prime-order G2 generator. Cofactor clearing is stated into n-torsion;
   do not silently replace that conclusion with Generated membership.
   Numerical coordinates and Lucas witnesses are untrusted proof inputs. *)

Theory bn254TwistCardinality
Ancestors
  namedPrimes bn254CofactorPrimes
  pairingTwistInstances pairingQuadraticFields namedPrimeFields
  ellipticCardinality ellipticCertificates ellipticTorsion shortWeierstrass
  prime
Libs
  pairingCurveCertificateLib

open arithmeticTheory dividesTheory pred_setTheory groupTheory monoidTheory
     fieldTheory ringTheory primeTheory

(* The coefficient is the standard 3/(9+i), as proved by
   bn254_g2_twist_coefficient. These coordinates and Lucas witnesses are
   untrusted certificate data; neither a point-count nor a primality verdict
   from the certificate generator is used as a proof. *)
Definition bn254_g2_full_cofactor_def:
  bn254_g2_full_cofactor = 2 * bn254_p - bn254_n
End

Definition bn254_g2_full_order_def:
  bn254_g2_full_order = bn254_n * bn254_g2_full_cofactor
End

Definition bn254_g2_full_generator_def:
  bn254_g2_full_generator = ECAffine
    [5445874226714546822889341762466925256591999629848719260987107810201350909642n;12592838791770409579915504805405962614533657406213188120227701164179749056507n]
    [2915570243818380100329091815840244199116706155384506911244110898928749640443n;14827009961206149930026064151155977024561453943664744252224353647782231023870n]
End


Theorem bn254_g2_full_cofactor_factorization:
  bn254_g2_full_cofactor =
    10069 * 5864401 * 1875725156269 *
    197620364512881247228717050342013327560683201906968909
Proof
  EVAL_TAC
QED

Theorem bn254_g2_full_order_value:
  bn254_g2_full_order =
    479095176016622842441988045216678740799252316531100822436447802254070093686356349204969212544220033486413271283566945264650845755880805213916963058350733
Proof
  EVAL_TAC
QED

Theorem bn254_g2_cardinality_field[local]:
  Field bn254_fp2
Proof
  metis_tac[bn254_fp2_finite_field, FiniteField_def]
QED

Theorem bn254_g2_full_generator_member:
  bn254_g2_full_generator IN sw_points bn254_fp2 bn254_g2_a bn254_g2_b
Proof
  let
    val defs = [bn254_fp2_def, bn254_fp2_poly_def, bn254_p_def,
      bn254_g2_a_def, bn254_g2_b_def, bn254_g2_full_generator_def,
      sw_points_member, sw_on_curve_def, sw_curve_rhs_def]
    val prime = REWRITE_RULE defs bn254_p_prime
    val field = REWRITE_RULE defs bn254_g2_cardinality_field
  in CONV_TAC (REWRITE_CONV defs THENC
       pairingCurveCertificateLib.FIELD_CONV prime field) end
QED

val cardinality_definitions =
  [bn254_g2_group_def, bn254_fp2_def, bn254_fp2_poly_def,
   bn254_p_def, bn254_n_def, bn254_g2_a_def, bn254_g2_b_def,
   bn254_g2_full_generator_def, bn254_g2_full_order_def,
   bn254_g2_full_cofactor_def];
fun cardinality_numeric th =
  CONV_RULE certificateComputeLib.NAT_CONV
    (REWRITE_RULE cardinality_definitions th);
val cardinality_prime = cardinality_numeric bn254_p_prime;
val cardinality_field = cardinality_numeric bn254_g2_cardinality_field;
val cardinality_curve = cardinality_numeric bn254_g2_curve;
val cardinality_member = cardinality_numeric bn254_g2_full_generator_member;
(* Goal normalization stays source-visible below; each timed certificate
   branch only proposes milestones, using these immutable numeric premises. *)
fun cardinality_scalar_tac goal =
  pairingCurveCertificateLib.SCALAR_CERTIFICATE_TAC
    cardinality_prime cardinality_field cardinality_curve
    cardinality_member goal;

fun cardinality_scalar_step_tac goal =
  pairingCurveCertificateLib.SCALAR_STEP_TAC
    cardinality_prime cardinality_field cardinality_curve
    cardinality_member goal;

