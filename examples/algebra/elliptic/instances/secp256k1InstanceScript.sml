(* secp256k1: affine curve and standard prime-order generator.

   Documentation
   Coordinates are natural-number residues in secp256k1_base_field; points
   are ECAffine x y or ECInfinity on y^2 = x^3 + 7. The named field and
   scalar-primality results are supplied by namedPrimeFields.

   Definitions: secp256k1_a_def, secp256k1_b_def, secp256k1_generator_def,
   secp256k1_group_def (all rational points), secp256k1_subgroup_def
   (Generated by the standard generator).

   Curve and membership: secp256k1_curve, secp256k1_generator_member,
   secp256k1_finite_group.
   Generator and subgroup: secp256k1_generator_annihilated,
   secp256k1_generator_order, secp256k1_subgroup_is_subgroup,
   secp256k1_subgroup_cyclic, secp256k1_subgroup_card.

   The order result concerns the generator, not yet the full group.
   cofactorOneInstances supplies secp256k1_generated_full_group. *)

Theory secp256k1Instance
Ancestors
  namedPrimes
  namedPrimeFields ellipticCertificates ellipticTorsion fieldInstances
  shortWeierstrass shortWeierstrassGroup
Libs
  ellipticCertificateLib

(* Standard affine parameters; no executable Verifereum arithmetic is imported. *)
Definition secp256k1_a_def:
  secp256k1_a :num = 0
End

Definition secp256k1_b_def:
  secp256k1_b :num = 7
End

Definition secp256k1_generator_def:
  secp256k1_generator = ECAffine (55066263022277343669578718895168534326250603453777594175500187360389116729240:num) (32670510020758816978083085130507043184471273380659243275938904335757337482424:num)
End

Definition secp256k1_group_def:
  secp256k1_group = sw_group secp256k1_base_field secp256k1_a secp256k1_b
End

Definition secp256k1_subgroup_def:
  secp256k1_subgroup = Generated secp256k1_group secp256k1_generator
End

Theorem secp256k1_curve:
  ShortWeierstrassCurve secp256k1_base_field secp256k1_a secp256k1_b
Proof
  REWRITE_TAC [ShortWeierstrassCurve_def] >>
  REWRITE_TAC [secp256k1_base_field_field, secp256k1_base_field_char] >>
  REWRITE_TAC [secp256k1_base_field_def, secp256k1_a_def,
    secp256k1_b_def, secp256k1_p_def, sw_discriminant_def,
    GF_eval, GF_sum_inv, monoidTheory.monoid_exp_def] >>
  CONV_TAC (certificateComputeLib.EVAL_CONV ())
QED

Theorem secp256k1_generator_member:
  secp256k1_generator IN sw_points secp256k1_base_field secp256k1_a secp256k1_b
Proof
  REWRITE_TAC [sw_points_member, sw_on_curve_def, sw_curve_rhs_def,
    secp256k1_base_field_def, secp256k1_p_def, secp256k1_a_def,
    secp256k1_b_def, secp256k1_generator_def, GF_eval,
    monoidTheory.monoid_exp_def] >>
  CONV_TAC (certificateComputeLib.EVAL_CONV ())
QED

Theorem secp256k1_finite_group:
  FiniteAbelianGroup secp256k1_group
Proof
  rw[secp256k1_group_def] >>
  irule short_weierstrass_finite_group >>
  simp[secp256k1_curve, secp256k1_base_field_finite_field]
QED

local
    val definitions = [secp256k1_group_def, secp256k1_base_field_def, secp256k1_p_def, secp256k1_a_def, secp256k1_b_def, secp256k1_generator_def, secp256k1_n_def]
    fun numeric th = CONV_RULE certificateComputeLib.NAT_CONV
      (REWRITE_RULE definitions th)
    val prime = numeric secp256k1_p_prime
    val curve = numeric secp256k1_curve
    val member = numeric secp256k1_generator_member
    val step = ellipticCertificateLib.SCALAR_STEP_TAC prime curve member
in
  val secp256k1_scalar_normalize = CONV_TAC (LAND_CONV
    (REWRITE_CONV definitions THENC certificateComputeLib.NAT_CONV))
  val secp256k1_scalar_certificate =
    ellipticCertificateLib.SCALAR_CERTIFICATE_TAC 4 prime curve member
  val secp256k1_scalar_step = step
end

Theorem secp256k1_generator_annihilated:
  secp256k1_group.exp secp256k1_generator secp256k1_n = ECInfinity
Proof
  secp256k1_scalar_normalize >>
  secp256k1_scalar_certificate
  >| [secp256k1_scalar_step, secp256k1_scalar_step,
      secp256k1_scalar_step, secp256k1_scalar_step,
      secp256k1_scalar_step, secp256k1_scalar_step,
      secp256k1_scalar_step, secp256k1_scalar_step,
      secp256k1_scalar_step, secp256k1_scalar_step,
      secp256k1_scalar_step, secp256k1_scalar_step,
      secp256k1_scalar_step, secp256k1_scalar_step,
      secp256k1_scalar_step, secp256k1_scalar_step,
      secp256k1_scalar_step, secp256k1_scalar_step,
      secp256k1_scalar_step, secp256k1_scalar_step,
      secp256k1_scalar_step, secp256k1_scalar_step,
      secp256k1_scalar_step, secp256k1_scalar_step,
      secp256k1_scalar_step, secp256k1_scalar_step,
      secp256k1_scalar_step, secp256k1_scalar_step,
      secp256k1_scalar_step, secp256k1_scalar_step,
      secp256k1_scalar_step, secp256k1_scalar_step,
      secp256k1_scalar_step, secp256k1_scalar_step,
      secp256k1_scalar_step, secp256k1_scalar_step,
      secp256k1_scalar_step, secp256k1_scalar_step,
      secp256k1_scalar_step, secp256k1_scalar_step,
      secp256k1_scalar_step, secp256k1_scalar_step,
      secp256k1_scalar_step, secp256k1_scalar_step,
      secp256k1_scalar_step, secp256k1_scalar_step,
      secp256k1_scalar_step, secp256k1_scalar_step,
      secp256k1_scalar_step, secp256k1_scalar_step,
      secp256k1_scalar_step, secp256k1_scalar_step,
      secp256k1_scalar_step, secp256k1_scalar_step,
      secp256k1_scalar_step, secp256k1_scalar_step,
      secp256k1_scalar_step, secp256k1_scalar_step,
      secp256k1_scalar_step, secp256k1_scalar_step,
      secp256k1_scalar_step, secp256k1_scalar_step,
      secp256k1_scalar_step, secp256k1_scalar_step]
QED

Theorem secp256k1_generator_order:
  order secp256k1_group secp256k1_generator = secp256k1_n
Proof
  rw[secp256k1_group_def] >>
  irule sw_prime_generator_order >>
  simp[secp256k1_curve, secp256k1_generator_member, secp256k1_n_prime,
       secp256k1_generator_def,
       REWRITE_RULE [secp256k1_group_def] secp256k1_generator_annihilated]
QED

Theorem secp256k1_subgroup_is_subgroup:
  Subgroup secp256k1_subgroup secp256k1_group
Proof
  rw[secp256k1_subgroup_def, secp256k1_group_def] >>
  irule sw_generated_subgroup >>
  simp[secp256k1_curve, secp256k1_generator_member, secp256k1_base_field_finite_field]
QED

Theorem secp256k1_subgroup_cyclic:
  cyclic secp256k1_subgroup
Proof
  rw[secp256k1_subgroup_def, secp256k1_group_def] >>
  irule sw_generated_cyclic >>
  simp[secp256k1_curve, secp256k1_generator_member, secp256k1_base_field_finite_field]
QED

Theorem secp256k1_subgroup_card:
  CARD secp256k1_subgroup.carrier = secp256k1_n
Proof
  rw[secp256k1_subgroup_def] >>
  `0 < secp256k1_n` by metis_tac[secp256k1_n_prime, dividesTheory.ONE_LT_PRIME,
                                      arithmeticTheory.LESS_TRANS, DECIDE ``(0:num) < 1``] >>
  metis_tac[sw_generator_card, secp256k1_curve, secp256k1_generator_member,
            secp256k1_group_def, secp256k1_generator_order]
QED

