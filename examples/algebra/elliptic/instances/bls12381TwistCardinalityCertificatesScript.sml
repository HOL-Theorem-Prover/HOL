(* BLS12-381 G2 cardinality: arithmetic and complex-multiplication inputs.

   Documentation
   Certificate computations concern y^2 = x^3 + 4+4*i in bls12381_fp2,
   using ascending coefficient lists and i^2 = -1. This theory separates
   the long scalar and field-power checks from bls12381TwistCardinality.

   Data: bls12381_g2_full_cofactor_def, bls12381_g2_torsion_factor_def,
   bls12381_g2_large_order_def, bls12381_g2_large_point_def,
   bls12381_g2_second_point_def, bls12381_g2_cardinality_subgroup_def.
   Arithmetic: bls12381_g2_full_cofactor_polynomial,
   bls12381_g2_full_cofactor_factorization.
   Scalar/CM interface: bls12381_g2_large_point_member,
   bls12381_g2_large_point_scalar_tests, bls12381_g2_cm_endomorphism,
   bls12381_g2_cm_third, bls12381_g2_cm_scalar_exclusions.
   Field-power interface: bls12381_g2_cubic_nonresidue_certificate.

   The two-factor cardinality subgroup is not the standard prime-order
   G2 subgroup. The full cofactor is not an effective hash-to-curve
   cofactor. Numerical witnesses propose claims for HOL proofs; external
   discovery is not a proof of their validity. *)

Theory bls12381TwistCardinalityCertificates

(* Kernel-checked scalar and field-power certificates used by the readable
   BLS12-381 twist cardinality argument. The explicit branches keep each
   arithmetic operation within the build's tactic-timeout boundary. *)
Ancestors
  namedPrimes bls12381TwistCofactorPrimes
  pairingTwistInstances ellipticCardinality ellipticCMMap ellipticCMCertificates
  prime number gcd ring
  namedPrimeFields pairingQuadraticFields fieldInstances ellipticCertificates
  shortWeierstrass shortWeierstrassGroup ellipticTorsion
Libs
  pairingCurveCertificateLib

open arithmeticTheory dividesTheory pred_setTheory groupTheory monoidTheory
     fieldTheory ringTheory fieldInstancesTheory primeTheory numberTheory gcdTheory

(* This is the full twist cofactor, not the effective hash-to-curve cofactor.
   Certificate discovery in PARI uses the actual curve y^2=x^3+4+4*i,
   i^2=-1.  Its invariant factors are M and 299, not N and 1.
   All numerical claims below are checked by HOL; no PARI verdict is used. *)
Definition bls12381_g2_full_cofactor_def:
  bls12381_g2_full_cofactor :num = 305502333931268344200999753193121504214466019254188142667664032982267604182971884026507427359259977847832272839041616661285803823378372096355777062779109
End

Definition bls12381_g2_torsion_factor_def:
  bls12381_g2_torsion_factor :num = 299
End


Definition bls12381_g2_large_order_def:
  bls12381_g2_large_order :num = 53576194808460553217203172723474824808344883275353018929305633902963132938098184426089150766896967993227272192442055963012237813401673323498414509448806171002635876817216134661849632732818260738617639084599158761113588926055983
End

Theorem bls12381_g2_full_cofactor_polynomial:
  !u. u = 15132376222941642752 ==>
  9 * bls12381_g2_full_cofactor =
    u ** 8 + 4 * u ** 7 + 5 * u ** 6 + 4 * u + 13 -
    (4 * u ** 4 + 6 * u ** 3 + 4 * u ** 2)
Proof
  rpt strip_tac >>
  PURE_ASM_REWRITE_TAC [bls12381_g2_full_cofactor_def] >>
  CONV_TAC certificateComputeLib.NAT_CONV >>
  EVAL_TAC
QED

Theorem bls12381_g2_full_cofactor_factorization:
  bls12381_g2_torsion_factor = 13 * 23 /\
  bls12381_g2_full_cofactor =
    13 ** 2 * 23 ** 2 * 2713 * 11953 * 262069 * bls12381_g2_cofactor_prime /\
  bls12381_g2_large_order =
    13 * 23 * 2713 * 11953 * 262069 * bls12381_g2_cofactor_prime * bls12381_n /\
  bls12381_g2_full_cofactor * bls12381_n =
    bls12381_g2_large_order * bls12381_g2_torsion_factor
Proof
  CONV_TAC
    (REWRITE_CONV
       [bls12381_g2_torsion_factor_def, bls12381_g2_full_cofactor_def,
        bls12381_g2_cofactor_prime_def, bls12381_g2_large_order_def,
        bls12381_n_def] THENC certificateComputeLib.NAT_CONV) >>
  EVAL_TAC
QED

