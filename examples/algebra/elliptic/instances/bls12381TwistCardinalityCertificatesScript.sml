Theorem bls12381_g2_large_point_scalar_tests:
  bls12381_g2_group.exp bls12381_g2_large_point bls12381_g2_large_order = ECInfinity /\
  bls12381_g2_group.exp bls12381_g2_large_point (bls12381_g2_large_order DIV 13) <> ECInfinity /\
  bls12381_g2_group.exp bls12381_g2_large_point (bls12381_g2_large_order DIV 23) <> ECInfinity /\
  bls12381_g2_group.exp bls12381_g2_large_point (bls12381_g2_large_order DIV 2713) <> ECInfinity /\
  bls12381_g2_group.exp bls12381_g2_large_point (bls12381_g2_large_order DIV 11953) <> ECInfinity /\
  bls12381_g2_group.exp bls12381_g2_large_point (bls12381_g2_large_order DIV 262069) <> ECInfinity /\
  bls12381_g2_group.exp bls12381_g2_large_point (bls12381_g2_large_order DIV bls12381_g2_cofactor_prime) <> ECInfinity /\
  bls12381_g2_group.exp bls12381_g2_large_point (bls12381_g2_large_order DIV bls12381_n) <> ECInfinity
