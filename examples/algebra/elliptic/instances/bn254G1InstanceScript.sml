(* BN254 G1: the base-field curve and its standard generator (1,2).

   Documentation
   The equation is y^2 = x^3 + 3 over bn254_base_field, with natural-number
   residue coordinates and ECAffine/ECInfinity points. Field and scalar
   primality results come from namedPrimeFields.

   Definitions: bn254_g1_a_def, bn254_g1_b_def, bn254_g1_generator_def,
   bn254_g1_group_def (all rational points), bn254_g1_subgroup_def
   (Generated by the standard generator).

   Curve and membership: bn254_g1_curve, bn254_g1_generator_member,
   bn254_g1_finite_group.
   Generator and subgroup: bn254_g1_generator_annihilated,
   bn254_g1_generator_order, bn254_g1_subgroup_is_subgroup,
   bn254_g1_subgroup_cyclic, bn254_g1_subgroup_card.

   cofactorOneInstances identifies this subgroup with the full G1 group.
   No G2 twist-cardinality claim is made by this theory. *)

Theory bn254G1Instance
Ancestors
  namedPrimes
  namedPrimeFields ellipticCertificates ellipticTorsion fieldInstances
  shortWeierstrass shortWeierstrassGroup
Libs
  ellipticCertificateLib

(* Standard affine parameters; no executable Verifereum arithmetic is imported. *)
Definition bn254_g1_a_def:
  bn254_g1_a :num = 0
End

Definition bn254_g1_b_def:
  bn254_g1_b :num = 3
End

Definition bn254_g1_generator_def:
  bn254_g1_generator = ECAffine (1:num) (2:num)
End

Definition bn254_g1_group_def:
  bn254_g1_group = sw_group bn254_base_field bn254_g1_a bn254_g1_b
End

Definition bn254_g1_subgroup_def:
  bn254_g1_subgroup = Generated bn254_g1_group bn254_g1_generator
End

Theorem bn254_g1_curve:
  ShortWeierstrassCurve bn254_base_field bn254_g1_a bn254_g1_b
Proof
  REWRITE_TAC [ShortWeierstrassCurve_def] >>
  REWRITE_TAC [bn254_base_field_field, bn254_base_field_char] >>
  REWRITE_TAC [bn254_base_field_def, bn254_g1_a_def,
    bn254_g1_b_def, bn254_p_def, sw_discriminant_def,
    GF_eval, GF_sum_inv, monoidTheory.monoid_exp_def] >>
  CONV_TAC (certificateComputeLib.EVAL_CONV ())
QED

Theorem bn254_g1_generator_member:
  bn254_g1_generator IN sw_points bn254_base_field bn254_g1_a bn254_g1_b
Proof
  REWRITE_TAC [sw_points_member, sw_on_curve_def, sw_curve_rhs_def,
    bn254_base_field_def, bn254_p_def, bn254_g1_a_def,
    bn254_g1_b_def, bn254_g1_generator_def, GF_eval,
    monoidTheory.monoid_exp_def] >>
  CONV_TAC (certificateComputeLib.EVAL_CONV ())
QED

Theorem bn254_g1_finite_group:
  FiniteAbelianGroup bn254_g1_group
Proof
  rw[bn254_g1_group_def] >>
  irule short_weierstrass_finite_group >>
  simp[bn254_g1_curve, bn254_base_field_finite_field]
QED

local
    val definitions = [bn254_g1_group_def, bn254_base_field_def, bn254_p_def, bn254_g1_a_def, bn254_g1_b_def, bn254_g1_generator_def, bn254_n_def]
    fun numeric th = CONV_RULE certificateComputeLib.NAT_CONV
      (REWRITE_RULE definitions th)
    val prime = numeric bn254_p_prime
    val curve = numeric bn254_g1_curve
    val member = numeric bn254_g1_generator_member
    val step = ellipticCertificateLib.SCALAR_STEP_TAC prime curve member
in
  val bn254_g1_scalar_normalize = CONV_TAC (LAND_CONV
    (REWRITE_CONV definitions THENC certificateComputeLib.NAT_CONV))
  val bn254_g1_scalar_certificate =
    ellipticCertificateLib.SCALAR_CERTIFICATE_TAC 4 prime curve member
  val bn254_g1_scalar_step = step
end

Theorem bn254_g1_generator_annihilated:
  bn254_g1_group.exp bn254_g1_generator bn254_n = ECInfinity
Proof
  bn254_g1_scalar_normalize >>
  bn254_g1_scalar_certificate
  >| [bn254_g1_scalar_step, bn254_g1_scalar_step,
      bn254_g1_scalar_step, bn254_g1_scalar_step,
      bn254_g1_scalar_step, bn254_g1_scalar_step,
      bn254_g1_scalar_step, bn254_g1_scalar_step,
      bn254_g1_scalar_step, bn254_g1_scalar_step,
      bn254_g1_scalar_step, bn254_g1_scalar_step,
      bn254_g1_scalar_step, bn254_g1_scalar_step,
      bn254_g1_scalar_step, bn254_g1_scalar_step,
      bn254_g1_scalar_step, bn254_g1_scalar_step,
      bn254_g1_scalar_step, bn254_g1_scalar_step,
      bn254_g1_scalar_step, bn254_g1_scalar_step,
      bn254_g1_scalar_step, bn254_g1_scalar_step,
      bn254_g1_scalar_step, bn254_g1_scalar_step,
      bn254_g1_scalar_step, bn254_g1_scalar_step,
      bn254_g1_scalar_step, bn254_g1_scalar_step,
      bn254_g1_scalar_step, bn254_g1_scalar_step,
      bn254_g1_scalar_step, bn254_g1_scalar_step,
      bn254_g1_scalar_step, bn254_g1_scalar_step,
      bn254_g1_scalar_step, bn254_g1_scalar_step,
      bn254_g1_scalar_step, bn254_g1_scalar_step,
      bn254_g1_scalar_step, bn254_g1_scalar_step,
      bn254_g1_scalar_step, bn254_g1_scalar_step,
      bn254_g1_scalar_step, bn254_g1_scalar_step,
      bn254_g1_scalar_step, bn254_g1_scalar_step,
      bn254_g1_scalar_step, bn254_g1_scalar_step,
      bn254_g1_scalar_step, bn254_g1_scalar_step,
      bn254_g1_scalar_step, bn254_g1_scalar_step,
      bn254_g1_scalar_step, bn254_g1_scalar_step,
      bn254_g1_scalar_step, bn254_g1_scalar_step,
      bn254_g1_scalar_step, bn254_g1_scalar_step,
      bn254_g1_scalar_step, bn254_g1_scalar_step,
      bn254_g1_scalar_step, bn254_g1_scalar_step]
QED

Theorem bn254_g1_generator_order:
  order bn254_g1_group bn254_g1_generator = bn254_n
Proof
  rw[bn254_g1_group_def] >>
  irule sw_prime_generator_order >>
  simp[bn254_g1_curve, bn254_g1_generator_member, bn254_n_prime,
       bn254_g1_generator_def,
       REWRITE_RULE [bn254_g1_group_def] bn254_g1_generator_annihilated]
QED

Theorem bn254_g1_subgroup_is_subgroup:
  Subgroup bn254_g1_subgroup bn254_g1_group
Proof
  rw[bn254_g1_subgroup_def, bn254_g1_group_def] >>
  irule sw_generated_subgroup >>
  simp[bn254_g1_curve, bn254_g1_generator_member, bn254_base_field_finite_field]
QED

Theorem bn254_g1_subgroup_cyclic:
  cyclic bn254_g1_subgroup
Proof
  rw[bn254_g1_subgroup_def, bn254_g1_group_def] >>
  irule sw_generated_cyclic >>
  simp[bn254_g1_curve, bn254_g1_generator_member, bn254_base_field_finite_field]
QED

Theorem bn254_g1_subgroup_card:
  CARD bn254_g1_subgroup.carrier = bn254_n
Proof
  rw[bn254_g1_subgroup_def] >>
  `0 < bn254_n` by metis_tac[bn254_n_prime, dividesTheory.ONE_LT_PRIME,
                                      arithmeticTheory.LESS_TRANS, DECIDE ``(0:num) < 1``] >>
  metis_tac[sw_generator_card, bn254_g1_curve, bn254_g1_generator_member,
            bn254_g1_group_def, bn254_g1_generator_order]
QED

