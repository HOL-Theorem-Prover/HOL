INCLUDES = ../.. ../model
CLINE_OPTIONS = --qof

ifdef POLY
HOLHEAP = riscv-heap
EXTRA_CLEANS = $(HOLHEAP) selftest.exe riscv-steplib-selftest.log \
               riscv-step-selftest.log

BARE_THYS = ../model/riscvTheory
DEPS = $(patsubst %,%.uo,$(BARE_THYS))

all: $(DEFAULT_TARGETS) $(HOLHEAP)
.PHONY: all

$(HOLHEAP): ../../l3-heap $(DEPS)
	$(protect $(HOLDIR)/bin/hol) buildheap -b $< -o $(HOLHEAP) $(BARE_THYS)

endif

all: selftest.exe

selftest.exe: selftest.uo riscv_stepLib.uo
	$(HOLMOSMLC) -o $@ $<

ifdef HOLSELFTESTLEVEL
all: riscv-steplib-selftest.log riscv-step-selftest.log

riscv-steplib-selftest.log: ../../common/testscript.ML riscv_stepLib.uo
	tmp=`mktemp "$${TMPDIR:-.}/stepLibXXXX"` && TESTLIB=riscv_stepLib $(protect $(HOLDIR)/bin/hol) < $< > $$tmp && $(MV) $$tmp $@

# riscv_step_hex on every riscv_dict entry, on every CSR and on edge cases,
# with the hypotheses of each theorem checked (see selftest.sml)
riscv-step-selftest.log: selftest.exe
	$(tee ./$<, $@)
endif
