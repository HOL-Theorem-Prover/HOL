ifdef POLY
HOLHEAP = $(HOLDIR)/bin/hol.state0
endif

cachefetch-selftest.log: selftest.exe
	@$(tee ./$<, $@)

selftest.exe: selftest.uo
	$(HOLMOSMLC) -o $@ $<

# The selftest builds subdir2/ at run time, as a sibling of subdir/, to
# check a cache hit across directories.  It removes it again on the way
# out; listing it here only covers a run that was killed first.
EXTRA_CLEANS = selftest.exe cachefetch-selftest.log subdir2/
