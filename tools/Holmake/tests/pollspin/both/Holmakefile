ifdef POLY
HOLHEAP = $(HOLDIR)/bin/hol.state0
endif

all: hung talky
.PHONY: all

# A hung-up job alongside a chatty one, built together.  This is what
# a real build looks like, and it is the case a per-round view of
# idleness gets wrong: talky keeps the loop hearing something, so a
# loop that asks "did this round achieve anything?" never concludes
# it is idle, and hung's permanently ready descriptor spins it
# between talky's messages.  Asking instead "has any one job gone
# quiet?" sees hung for what it is.
hung:
	echo starting ; exec 1>&- 2>&- ; sleep 2 && touch hung

# chatter.exe is run from its own directory because it is a wrapper
# that asks hol to load the `chatter' module, and that is looked up
# relative to the working directory.  `&&' rather than `;' so that a
# chatter which failed to run cannot leave a touched target behind
# looking like a build that worked.
talky:
	( cd .. && ./chatter.exe ) && touch talky

EXTRA_CLEANS = hung talky
