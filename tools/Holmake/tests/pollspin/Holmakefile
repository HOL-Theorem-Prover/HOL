ifdef POLY
HOLHEAP = $(HOLDIR)/bin/hol.state0
endif

pollspin-selftest.log: selftest.exe chatter.exe
	@$(tee ./$<, $@)

selftest.exe: selftest.uo
	$(HOLMOSMLC) -o $@ $<

# both/ runs this; see chatter.sml for why it is a program
# rather than a shell loop.
chatter.exe: chatter.uo
	$(HOLMOSMLC) -o $@ $<

EXTRA_CLEANS = selftest.exe chatter.exe pollspin-selftest.log \
               spinner/hung both/hung both/talky
