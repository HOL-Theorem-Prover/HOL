INCLUDES = base
LOGDIR = .hol/logs
EXTRA_CLEANS = ls-base-output ls-child-output

ifdef HOL_NUMJOBS
ifneq ($(HOL_NUMJOBS), 1)

# diff rather than tools/cmp/cmp.exe, as in the repl test: cmp.exe exits
# non-zero and says nothing, which leaves a mismatch that only shows up
# under CI's scheduling with no trace of which log file was unexpected.
CMP = diff -a

.PHONY: all check

all: $(DEFAULT_TARGETS) check

check: ls-child-expected ls-base-expected childTheory.uo
	/bin/ls -1 $(LOGDIR) 2>&1 > ls-child-output && \
          $(CMP) ls-child-expected ls-child-output
	/bin/ls -1 base/$(LOGDIR) 2>&1 > ls-base-output && \
          $(CMP) ls-base-expected ls-base-output

endif
endif

