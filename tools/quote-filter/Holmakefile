CLINE_OPTIONS = --no_overlay --no_prereqs
EXTRA_CLEANS = filter.sml quote-filter selftest quotefix-selftest.log

all: quote-filter
.PHONY: all

ifdef POLY
CLINE_OPTIONS += --poly_not_hol

# A driver's dependencies are exactly the files it `use`s.
UNQUOTE_DEPS = $(shell grep '^use ' poly-unquote.ML | cut -d'"' -f2)
SELFTEST_DEPS = $(shell grep '^use ' poly-selftest.ML | cut -d'"' -f2)

quote-filter: poly-unquote.ML $(UNQUOTE_DEPS)
	$(POLYC) -o $@ $<

selftest: poly-selftest.ML $(SELFTEST_DEPS)
	$(POLYC) -o $@ $<

else

# The -I list configure uses to build bin/unquote.
INCLUDES = $(HOLDIR)/tools/Holmake $(HOLDIR)/tools/Holmake/mosml \
           $(HOLDIR)/tools/Holmake/hfs $(HOLDIR)/tools/parsing \
           $(HOLDIR)/src/portableML

quote-filter: quote-filter.uo
	$(HOLMOSMLC) -o $@ $<

# Toplevel mode lets mosml-selftest.sml call main.
selftest.uo selftest.ui: selftest.sml quotefix.uo
	$(MOSMLC) -toplevel -c $<

mosml-selftest.uo: mosml-selftest.sml selftest.ui
	$(MOSMLC) -c selftest.ui $<

selftest: mosml-selftest.uo selftest.uo
	$(MOSMLC) -o $@ $<

endif

ifdef HOLSELFTESTLEVEL
all: quotefix-selftest.log

quotefix-selftest.log: selftest
	$(tee ./selftest, $@)
endif
